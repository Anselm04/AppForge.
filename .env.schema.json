{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AppForge Environment Schema",
  "type": "object",
  "properties": {
    "NODE_ENV": {
      "type": "string",
      "enum": ["development", "staging", "production", "test"],
      "description": "Application environment"
    },
    "SUPABASE_URL": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://.*\\.supabase\\.co",
      "description": "Supabase project URL"
    },
    "SUPABASE_ANON_KEY": {
      "type": "string",
      "minLength": 10,
      "description": "Supabase anonymous key"
    },
    "STRIPE_SECRET_KEY": {
      "type": "string",
      "pattern": "^sk_(test_|live_)?[a-zA-Z0-9]+",
      "description": "Stripe secret key"
    },
    "STRIPE_WEBHOOK_SECRET": {
      "type": "string",
      "pattern": "^whsec_[a-zA-Z0-9]+",
      "description": "Stripe webhook signing secret"
    },
    "REDIS_URL": {
      "type": "string",
      "format": "uri",
      "pattern": "^redis(s)?://.*",
      "description": "Redis connection URL"
    },
    "SENTRY_DSN": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://.*@.*\\.sentry\\.io/.*",
      "description": "Sentry backend DSN"
    },
    "VITE_SENTRY_DSN": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://.*@.*\\.sentry\\.io/.*",
      "description": "Sentry frontend DSN"
    },
    "DATABASE_URL": {
      "type": "string",
      "format": "uri",
      "pattern": "^postgresql://.*",
      "description": "PostgreSQL database URL"
    },
    "SUPABASE_DB_URL": {
      "type": "string",
      "format": "uri",
      "pattern": "^postgresql://.*",
      "description": "Supabase database URL"
    },
    "JWT_SECRET": {
      "type": "string",
      "minLength": 32,
      "description": "JWT signing secret (min 32 chars)"
    },
    "COOKIE_SECRET": {
      "type": "string",
      "minLength": 32,
      "description": "Cookie signing secret (min 32 chars)"
    },
    "CORS_ORIGIN": {
      "type": "string",
      "description": "CORS origin for production (e.g., https://appforge.yourdomain.com)"
    },
    "REQUEST_TIMEOUT_MS": {
      "type": "integer",
      "minimum": 5000,
      "maximum": 300000,
      "description": "Request timeout in milliseconds"
    },
    "GITHUB_CLIENT_ID": {
      "type": "string",
      "description": "GitHub OAuth client ID"
    },
    "GITHUB_CLIENT_SECRET": {
      "type": "string",
      "description": "GitHub OAuth client secret"
    },
    "COSINE_API_KEY": {
      "type": "string",
      "description": "Cosine Genie 2 API key"
    },
    "COSINE_API_URL": {
      "type": "string",
      "format": "uri",
      "description": "Cosine API URL"
    },
    "VITE_APP_ID": {
      "type": "string",
      "description": "Application ID for client-side tracking"
    }
  },
  "required": ["NODE_ENV"],
  "anyOf": [
    { "required": ["SUPABASE_URL"] },
    { "required": ["DATABASE_URL"] },
    { "required": ["SUPABASE_DB_URL"] }
  ],
  "allOf": [
    {
      "anyOf": [
        { "required": ["JWT_SECRET"] },
        { "required": ["COOKIE_SECRET"] }
      ]
    }
  ]
}
