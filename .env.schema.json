{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AppForge Environment Schema",
  "description": "Shape-level environment schema. Production readiness is enforced by src/utils/env-validator.ts; AI-provider readiness is defined by src/lib/llmProviderConfig.ts.",
  "type": "object",
  "properties": {
    "NODE_ENV": {
      "type": "string",
      "enum": ["development", "staging", "production", "test"],
      "description": "Application environment"
    },
    "SUPABASE_URL": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "Supabase project URL"
    },
    "VITE_SUPABASE_URL": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "Browser-visible Supabase project URL"
    },
    "SUPABASE_ANON_KEY": { "type": "string", "minLength": 10 },
    "VITE_SUPABASE_ANON_KEY": { "type": "string", "minLength": 10 },
    "VITE_SUPABASE_PUBLISHABLE_KEY": { "type": "string", "minLength": 10 },
    "SUPABASE_SERVICE_ROLE_KEY": { "type": "string", "minLength": 10 },
    "STRIPE_SECRET_KEY": {
      "type": "string",
      "pattern": "^sk_(test_|live_)?[a-zA-Z0-9]+"
    },
    "STRIPE_WEBHOOK_SECRET": {
      "type": "string",
      "pattern": "^whsec_[a-zA-Z0-9]+"
    },
    "STRIPE_STARTER_PRICE_ID": { "type": "string" },
    "STRIPE_BUILDER_PRICE_ID": { "type": "string" },
    "STRIPE_STUDIO_PRICE_ID": { "type": "string" },
    "STRIPE_ENTERPRISE_PRICE_ID": { "type": "string" },
    "STRIPE_CUSTOM_PRICE_ID": { "type": "string" },
    "STRIPE_CREDITS_50_PRICE_ID": { "type": "string" },
    "STRIPE_CREDITS_100_PRICE_ID": { "type": "string" },
    "STRIPE_CREDITS_250_PRICE_ID": { "type": "string" },
    "REDIS_URL": {
      "type": "string",
      "format": "uri",
      "pattern": "^redis(s)?://.*"
    },
    "SENTRY_DSN": { "type": "string", "format": "uri" },
    "VITE_SENTRY_DSN": { "type": "string", "format": "uri" },
    "DATABASE_URL": {
      "type": "string",
      "format": "uri",
      "pattern": "^postgresql://.*"
    },
    "SUPABASE_DB_URL": {
      "type": "string",
      "format": "uri",
      "pattern": "^postgresql://.*"
    },
    "JWT_SECRET": { "type": "string", "minLength": 32 },
    "COOKIE_SECRET": { "type": "string", "minLength": 32 },
    "CORS_ORIGIN": { "type": "string" },
    "APP_URL": { "type": "string", "format": "uri" },
    "PUBLIC_APP_URL": { "type": "string", "format": "uri" },
    "REQUEST_TIMEOUT_MS": {
      "type": "integer",
      "minimum": 5000,
      "maximum": 360000,
      "description": "Request timeout in milliseconds; runtime validator is authoritative"
    },
    "GITHUB_CLIENT_ID": { "type": "string" },
    "GITHUB_CLIENT_SECRET": { "type": "string" },
    "VITE_APP_ID": { "type": "string" },
    "OWNER_EMAIL": { "type": "string" },
    "OWNER_PHONE": { "type": "string" },
    "HCAPTCHA_SECRET": { "type": "string" },
    "RESEND_API_KEY": { "type": "string" },
    "VERCEL_TOKEN": { "type": "string" },
    "VERCEL_TEAM_ID": { "type": "string" },
    "NETLIFY_AUTH_TOKEN": { "type": "string" },
    "FLY_API_TOKEN": { "type": "string" },
    "GROQ_API_KEY": { "type": "string" },
    "DEEPSEEK_API_KEY": { "type": "string" },
    "GEMINI_API_KEY": { "type": "string" },
    "GOOGLE_API_KEY": { "type": "string" },
    "OPENROUTER_API_KEY": { "type": "string" },
    "CEREBRAS_API_KEY": { "type": "string" },
    "MISTRAL_API_KEY": { "type": "string" },
    "TOGETHER_API_KEY": { "type": "string" },
    "FIREWORKS_API_KEY": { "type": "string" },
    "HF_TOKEN": { "type": "string" },
    "HUGGINGFACE_API_KEY": { "type": "string" },
    "OLLAMA_BASE_URL": { "type": "string", "format": "uri" },
    "OLLAMA_API_KEY": { "type": "string" },
    "OLLAMA_ENABLED": { "type": "string" },
    "OPENAI_COMPAT_BASE_URL": { "type": "string", "format": "uri" },
    "OPENAI_COMPAT_API_KEY": { "type": "string" },
    "BUILT_IN_FORGE_API_URL": { "type": "string", "format": "uri" },
    "BUILT_IN_FORGE_API_KEY": { "type": "string" },
    "FORGE_API_KEY": { "type": "string" },
    "OPENAI_API_KEY": { "type": "string" }
  },
  "required": ["NODE_ENV"]
}
