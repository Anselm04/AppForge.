# AppForge Environment Configuration
# Copy this file to .env and fill in your values.
# Runtime production readiness is enforced by src/utils/env-validator.ts.

# ============================================
# Application
# ============================================
NODE_ENV=development

# ============================================
# Database / Supabase
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# DATABASE_URL=postgresql://user:password@localhost:5432/appforge
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ============================================
# Authentication
# ============================================
JWT_SECRET=your-jwt-secret-min-32-chars-long
COOKIE_SECRET=your-cookie-secret-min-32-chars-long

# ============================================
# Stripe billing
# ============================================
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_STARTER_PRICE_ID=price_1UB11WKFfiU4ONpqujQV0YA1
STRIPE_BUILDER_PRICE_ID=price_1UB11WKFfiU4ONpqcI7FYT9F
STRIPE_STUDIO_PRICE_ID=price_1UB11XKFfiU4ONpq5vNU84rn
STRIPE_ENTERPRISE_PRICE_ID=price_1UB11XKFfiU4ONpqWm4VsqWi
STRIPE_CUSTOM_PRICE_ID=
STRIPE_CREDITS_50_PRICE_ID=price_1UB11YKFfiU4ONpq9lxQxD0t
STRIPE_CREDITS_100_PRICE_ID=price_1UB11YKFfiU4ONpqxG2boP66
STRIPE_CREDITS_250_PRICE_ID=price_1UB11ZKFfiU4ONpq3bUBdUuS

# ============================================
# Holy Trinity ecosystem
# ============================================
MARKETING_APP_URL=https://your-marketing-app.example.com
TRILLION_ECOSYSTEM_SHARED_SECRET=replace-with-long-random-shared-secret
TRILLION_PUBLIC_SITE_URL=https://trillionaitech.com

# ============================================
# BubblaV AI support
# ============================================
BUBBLAV_API_KEY=
BUBBLAV_HEALTH_URL=
BUBBLAV_CHAT_URL=
# BUBBLAV_API_URL=                # Chat endpoint alias

# ============================================
# Make workflow automation
# ============================================
MAKE_WEBHOOK_URL=
MAKE_API_TOKEN=
MAKE_HEALTH_URL=

# ============================================
# Datadog production monitoring
# ============================================
DD_API_KEY=
DD_SITE=datadoghq.com

# ============================================
# PostHog product analytics / feature flags
# ============================================
POSTHOG_HOST=https://eu.posthog.com
POSTHOG_KEY=
VITE_POSTHOG_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# ============================================
# GitHub source control / CI
# ============================================
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# Fly.io / agent runtime
# ============================================
FLY_APP_NAME=appforge
FLY_API_TOKEN=
# The ChatGPT Sprites plugin is not callable from the deployed AppForge server.
# Configure the server-side Sprites bridge endpoints below for runtime execution.
SPRITES_HEALTH_URL=
SPRITES_EXEC_URL=
SPRITES_BUILD_URL=
SPRITES_API_TOKEN=

# ============================================
# Codex Security review runtime
# ============================================
CODEX_SECURITY_HEALTH_URL=
CODEX_SECURITY_EXEC_URL=
CODEX_SECURITY_TOKEN=

# ============================================
# Vercel deployment
# ============================================
VERCEL_TOKEN=your-vercel-token
# VERCEL_TEAM_ID=your-team-id

# ============================================
# AI providers / research
# ============================================
# Configure at least ONE supported build provider. The canonical readiness rule
# lives in src/lib/llmProviderConfig.ts and the runtime registry in
# src/lib/llmProviders.ts. Do not add provider names here unless runtime support
# exists as well.
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=                 # Gemini alias
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
HF_TOKEN=
# HUGGINGFACE_API_KEY=            # Hugging Face alias
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_API_KEY=
# OPENAI_COMPAT_BASE_URL=https://your-openai-compatible-host/v1
# OPENAI_COMPAT_API_KEY=
# BUILT_IN_FORGE_API_URL=https://forge.manus.im/v1
# BUILT_IN_FORGE_API_KEY=
# FORGE_API_KEY=                  # Forge alias
OPENAI_API_KEY=

# Live planning research providers
TAVILY_API_KEY=
SERPAPI_API_KEY=

# ============================================
# Admin, SMS, captcha, email
# ============================================
OWNER_EMAIL=owner@example.com
OWNER_PHONE=+64000000000
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-service-sid
# TWILIO_PHONE_NUMBER=+1234567890
# HCAPTCHA_SITE_KEY=your-site-key
# HCAPTCHA_SECRET=your-secret-key
# RESEND_API_KEY=resend_sk_xxxxxx

# ============================================
# Cache, errors, compliance, logging
# ============================================
# Production multi-machine AppForge requires REDIS_URL.
# REDIS_URL=rediss://your-redis-url:6380
# SENTRY_DSN=https://key@sentry.io/project-id
# VITE_SENTRY_DSN=https://key@sentry.io/project-id
# SENTRY_API_TOKEN=sentry_auth_token_xxx
# SENTRY_ORG_SLUG=your-org
# SENTRY_PROJECT_SLUG=appforge-prod
# VANTA_WORKSPACE_ID=your-vanta-workspace-id
# VANTA_API_TOKEN=vanta_sk_xxxxxx
# LOGTAIL_SOURCE_TOKEN=your-logtail-source-token

# ============================================
# Security / performance / canonical URLs
# ============================================
# CORS_ORIGIN=https://appforge.yourdomain.com
# APP_URL=https://appforge.yourdomain.com
# PUBLIC_APP_URL=https://appforge.yourdomain.com
# REQUEST_TIMEOUT_MS=330000

# Never commit real secrets. Configure production secrets in the deployment platform.
