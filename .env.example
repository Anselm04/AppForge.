# AppForge Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Application
# ============================================
NODE_ENV=development

# ============================================
# Database (Required - choose one)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# DATABASE_URL=postgresql://user:password@localhost:5432/appforge
# SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ============================================
# Authentication
# ============================================
JWT_SECRET=your-jwt-secret-min-32-chars-long
COOKIE_SECRET=your-cookie-secret-min-32-chars-long

# ============================================
# Supabase (Required for auth & database)
# ============================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ============================================
# Stripe (Required for billing)
# ============================================
# Price IDs are safe to expose and are pinned to the verified live AppForge
# products. Use sk_test_/test-mode price IDs in local development if desired.
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_STARTER_PRICE_ID=price_1UB11WKFfiU4ONpqujQV0YA1
STRIPE_BUILDER_PRICE_ID=price_1UB11WKFfiU4ONpqcI7FYT9F
STRIPE_STUDIO_PRICE_ID=price_1UB11XKFfiU4ONpq5vNU84rn
STRIPE_ENTERPRISE_PRICE_ID=price_1UB11XKFfiU4ONpqWm4VsqWi
STRIPE_CUSTOM_PRICE_ID=
STRIPE_CREDITS_50_PRICE_ID=price_1UB11YKFfiU4ONpq9lxQxD0t
STRIPE_CREDITS_100_PRICE_ID=price_1UB11YKFfiU4ONpqxG2boP66
STRIPE_CREDITS_250_PRICE_ID=price_1UB11ZKFfiU4ONpq3bUBdUuS

# ============================================
# Holy Trinity ecosystem
# ============================================
# AppForge server -> TrillionAI Marketing server.
MARKETING_APP_URL=https://your-marketing-app.example.com
# Use the exact same long random value in the marketing app deployment.
TRILLION_ECOSYSTEM_SHARED_SECRET=replace-with-long-random-shared-secret
# Public company website used by the live ecosystem health verifier.
TRILLION_PUBLIC_SITE_URL=https://trillionaitech.com

# ============================================
# BubblaV AI support
# ============================================
BUBBLAV_API_KEY=
# Exact non-mutating provider endpoint used only to verify connectivity.
BUBBLAV_HEALTH_URL=
# Exact provider endpoint that accepts support/chat POST requests.
BUBBLAV_CHAT_URL=
# Optional widget identifier if the browser support widget is enabled later.
BUBBLAV_WIDGET_ID=

# ============================================
# Make workflow automation
# ============================================
# Scenario webhook called by AppForge server-side automation actions.
MAKE_WEBHOOK_URL=
MAKE_API_TOKEN=
# Non-mutating endpoint used by the integration health check.
MAKE_HEALTH_URL=

# ============================================
# Datadog production monitoring
# ============================================
DD_API_KEY=
DD_SITE=datadoghq.com

# ============================================
# PostHog product analytics / feature flags
# ============================================
POSTHOG_HOST=https://eu.posthog.com
# Project ingestion key for server-side event capture.
POSTHOG_KEY=
# Optional browser key if client capture is enabled.
VITE_POSTHOG_KEY=
# Personal API key + project ID are used only for non-mutating verification.
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# ============================================
# GitHub source control / CI
# ============================================
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# Fly.io / agent runtime
# ============================================
FLY_APP_NAME=appforge
FLY_API_TOKEN=

# ============================================
# Vercel deployment
# ============================================
VERCEL_TOKEN=your-vercel-token
# VERCEL_TEAM_ID=your-team-id

# ============================================
# AI providers / research
# ============================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# BUILT_IN_FORGE_API_URL=https://forge.manus.im
# BUILT_IN_FORGE_API_KEY=your-forge-api-key

# ============================================
# Admin, SMS, captcha, email
# ============================================
OWNER_EMAIL=owner@example.com
OWNER_PHONE=+64000000000
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
# HCAPTCHA_SITE_KEY=your-site-key
# HCAPTCHA_SECRET=your-secret-key
# RESEND_API_KEY=resend_sk_xxxxxx

# ============================================
# Cache, errors, compliance, logging
# ============================================
# REDIS_URL=rediss://your-redis-url:6380
# SENTRY_DSN=https://key@sentry.io/project-id
# VITE_SENTRY_DSN=https://key@sentry.io/project-id
# SENTRY_API_TOKEN=sentry_auth_token_xxx
# SENTRY_ORG_SLUG=your-org
# SENTRY_PROJECT_SLUG=appforge-prod
# VANTA_WORKSPACE_ID=your-vanta-workspace-id
# VANTA_API_TOKEN=vanta_sk_xxxxxx
# LOGTAIL_SOURCE_TOKEN=your-logtail-source-token

# ============================================
# Security / performance
# ============================================
# CORS_ORIGIN=https://appforge.yourdomain.com
# REQUEST_TIMEOUT_MS=30000

# Never commit real secrets. Configure production secrets in the deployment platform.
