# AppForge Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Application
# ============================================
NODE_ENV=development

# ============================================
# Database (Required - choose one)
# ============================================

# Option 1: Supabase (Recommended)
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Option 2: Direct PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/appforge

# Option 3: Supabase Database URL
# SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ============================================
# Payments (Optional - for Stripe integration)
# ============================================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ============================================
# Caching (Optional - for distributed rate limiting)
# ============================================
# REDIS_URL=redis://localhost:6379
# REDIS_URL=rediss://your-redis-url:6380

# ============================================
# Error Tracking (Optional - for Sentry)
# ============================================
# Get from: https://sentry.io/settings/your-org/projects/
# SENTRY_DSN=https://key@sentry.io/project-id
# VITE_SENTRY_DSN=https://key@sentry.io/project-id

# ============================================
# Notes
# ============================================
# - NODE_ENV: development, staging, production, or test
# - At least one database option must be configured
# - Use strong, randomly generated secrets in production
# - Never commit .env file to version control
# - Use .env.example as a template only
