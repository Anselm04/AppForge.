# AppForge Environment Configuration
# Copy this file to .env and fill in your values. Never commit production secrets.

# ============================================
# Application
# ============================================
NODE_ENV=development

# ============================================
# Database (Required - choose one)
# ============================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# DATABASE_URL=postgresql://user:password@localhost:5432/appforge
# SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ============================================
# Authentication
# ============================================
JWT_SECRET=your-jwt-secret-min-32-chars-long
COOKIE_SECRET=your-cookie-secret-min-32-chars-long
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ============================================
# Stripe billing and subscriptions
# ============================================
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_STARTER_PRICE_ID=price_1U1k58A9fJMsgjuEHj608a6h
STRIPE_BUILDER_PRICE_ID=price_1U1k5wA9fJMsgjuEXXRqll6x
STRIPE_STUDIO_PRICE_ID=price_1U1k6NA9fJMsgjuErSFn8QCW
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_monthly
STRIPE_CUSTOM_PRICE_ID=price_custom_monthly
STRIPE_STARTER_PAYMENT_LINK=https://buy.stripe.com/aFa8wOb7Dfe7f781tecfK01
STRIPE_BUILDER_PAYMENT_LINK=https://buy.stripe.com/00w7sKcbHfe7cZ0eg0cfK02
STRIPE_STUDIO_PAYMENT_LINK=https://buy.stripe.com/eVq14m1x3c1V3oq9ZKcfK03

# ============================================
# Holy Trinity ecosystem
# ============================================
# AppForge sends completed products to TrillionAI Marketing through a signed server-to-server bridge.
MARKETING_APP_URL=https://trillionai-marketing.fly.dev
TRILLION_PUBLIC_SITE_URL=https://trillionaitech.com
# Generate a unique 32+ byte value and set the SAME secret in AppForge and the marketing app.
TRILLION_ECOSYSTEM_SHARED_SECRET=replace-with-a-long-random-shared-secret

# ============================================
# GitHub source control / CI
# ============================================
# Runtime token used only by AppForge's GitHub adapter and health verification.
GITHUB_TOKEN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ============================================
# Fly.io / Sprites-style execution runtime
# ============================================
FLY_APP_NAME=appforge-unfurling-moon-9058
# FLY_API_TOKEN is required by deployment automation; keep it in secret storage.
FLY_API_TOKEN=

# ============================================
# Vercel deployment adapter
# ============================================
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ============================================
# Make automation
# ============================================
MAKE_API_TOKEN=
# Explicit non-mutating endpoint used by AppForge to verify the Make connection.
MAKE_HEALTH_URL=
# Optional workflow webhook; never use the webhook itself as a health check if it triggers work.
MAKE_WEBHOOK_URL=

# ============================================
# BubblaV support
# ============================================
BUBBLAV_API_KEY=
BUBBLAV_WIDGET_ID=
# Explicit non-mutating endpoint used to verify BubblaV without creating support activity.
BUBBLAV_HEALTH_URL=

# ============================================
# Datadog US1 monitoring
# ============================================
DD_API_KEY=
DD_SITE=datadoghq.com

# ============================================
# PostHog analytics / feature flags
# ============================================
POSTHOG_HOST=https://eu.posthog.com
VITE_POSTHOG_HOST=https://eu.posthog.com
VITE_POSTHOG_KEY=
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# ============================================
# Sentry error tracking
# ============================================
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_API_TOKEN=
SENTRY_ORG_SLUG=
SENTRY_PROJECT_SLUG=

# ============================================
# AI / Deep Research providers
# ============================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=

# ============================================
# Codex Security runtime bridge
# ============================================
# A ChatGPT-side Codex Security plugin is not automatically available to deployed AppForge.
# Only configure these after an approved callable runtime endpoint exists.
CODEX_SECURITY_WEBHOOK_URL=
CODEX_SECURITY_TOKEN=

# ============================================
# Twilio communications
# ============================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================
# Caching / queues
# ============================================
REDIS_URL=

# ============================================
# Security / CORS / bot protection
# ============================================
CORS_ORIGIN=http://localhost:5173
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# ============================================
# Admin owner configuration
# ============================================
OWNER_EMAIL=owner@example.com
OWNER_PHONE=+10000000000

# ============================================
# Optional compliance / email / logs
# ============================================
VANTA_WORKSPACE_ID=
VANTA_API_TOKEN=
RESEND_API_KEY=
LOGTAIL_SOURCE_TOKEN=

# ============================================
# Runtime tuning
# ============================================
REQUEST_TIMEOUT_MS=330000
ENFORCE_ENV_VALIDATION=true

# Production rules
# - Store all real keys/tokens in Fly/GitHub/provider secret stores, never in source control.
# - Integration UI must use the runtime verification API; env presence alone is not "Connected".
# - Do not use live Stripe checkout/charges as a health check.
# - AppForge and TrillionAI Marketing must share TRILLION_ECOSYSTEM_SHARED_SECRET.
# - Production URLs must use HTTPS.
