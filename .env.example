# AppForge Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# Application
# ============================================
NODE_ENV=development

# ============================================
# Database (Required - choose one)
# ============================================

# Option 1: Supabase (Recommended)
# Get from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Option 2: Direct PostgreSQL
# DATABASE_URL=postgresql://user:password@localhost:5432/appforge

# Option 3: Supabase Database URL
# SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ============================================
# Authentication
# ============================================
# Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=your-jwt-secret-min-32-chars-long
COOKIE_SECRET=your-cookie-secret-min-32-chars-long

# ============================================
# Supabase (Required for auth & database)
# ============================================
# Get from: https://app.supabase.com/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ============================================
# Payments (Required for Stripe billing & subscriptions)
# ============================================
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Subscription price IDs (create in Stripe Dashboard > Products > Prices)
# Starter: US$49/month - 100 compute credits/month, 16 builds/month
STRIPE_STARTER_PRICE_ID=price_1U1k58A9fJMsgjuEHj608a6h
# Builder: US$149/month - 400 compute credits/month, 66 builds/month
STRIPE_BUILDER_PRICE_ID=price_1U1k5wA9fJMsgjuEXXRqll6x
# Studio: US$399/month - 1,500 compute credits/month, unlimited builds
STRIPE_STUDIO_PRICE_ID=price_1U1k6NA9fJMsgjuErSFn8QCW
# Enterprise: US$896+/month - custom contract, unlimited everything
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_monthly
# Custom: custom quote via sales@appforge.dev
STRIPE_CUSTOM_PRICE_ID=price_custom_monthly

# Stripe Payment Links (for direct checkout redirects)
# Get from: https://dashboard.stripe.com/payment-links
# Starter: https://buy.stripe.com/aFa8wOb7Dfe7f781tecfK01
STRIPE_STARTER_PAYMENT_LINK=https://buy.stripe.com/aFa8wOb7Dfe7f781tecfK01
# Builder: https://buy.stripe.com/00w7sKcbHfe7cZ0eg0cfK02
STRIPE_BUILDER_PAYMENT_LINK=https://buy.stripe.com/00w7sKcbHfe7cZ0eg0cfK02
# Studio: https://buy.stripe.com/eVq14m1x3c1V3oq9ZKcfK03
STRIPE_STUDIO_PAYMENT_LINK=https://buy.stripe.com/eVq14m1x3c1V3oq9ZKcfK03

# ============================================
# Vercel (Required for one-click deployments)
# ============================================
# Get from: https://vercel.com/account/tokens
VERCEL_TOKEN=your-vercel-token
# Optional: Vercel team ID if deploying under a team
# VERCEL_TEAM_ID=your-team-id

# ============================================
# Caching (Optional - for distributed rate limiting)
# ============================================
# REDIS_URL=redis://localhost:6379
# REDIS_URL=rediss://your-redis-url:6380

# ============================================
# Error Tracking (Optional - for Sentry)
# ============================================
# Get from: https://sentry.io/settings/your-org/projects/
# SENTRY_DSN=https://key@sentry.io/project-id
# VITE_SENTRY_DSN=https://key@sentry.io/project-id
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Self-Healing Monitor (requires Sentry API access to poll issues)
# SENTRY_API_TOKEN=sentry_auth_token_xxx
# SENTRY_ORG_SLUG=your-org
# SENTRY_PROJECT_SLUG=appforge-prod

# ============================================
# Security
# ============================================
# CORS origin for production (set to your domain, or 'false' to disable CORS in dev)
# CORS_ORIGIN=https://appforge.yourdomain.com

# ============================================
# Performance
# ============================================
# Request timeout in milliseconds (default: 30000 = 30s)
# REQUEST_TIMEOUT_MS=30000

# ============================================
# Build / Deployment
# ============================================
# LLM API for the multi-agent pipeline (default: forge.manus.im)
# BUILT_IN_FORGE_API_URL=https://forge.manus.im
# BUILT_IN_FORGE_API_KEY=your-forge-api-key

# ============================================
# Notes
# ============================================
# - NODE_ENV: development, staging, production, or test
# - Supabase vars are required for auth and database to work
# - Stripe price IDs must be created in your Stripe Dashboard first
# - All paid tiers include a 7-day free trial by default
# - Credit allocation:
#   Free:    20 credits/month  (3 builds)
#   Starter: 100 credits/month (16 builds)
#   Builder: 400 credits/month (66 builds)
#   Studio:  1,500 credits/month (unlimited builds)
#   Enterprise: unlimited (custom contract)
# - Build = Planner(2cr) + Coder(3cr) + Reviewer(1cr) = 6 credits avg
# - Use strong, randomly generated secrets in production (min 32 chars)
# - Never commit .env file to version control
# - Use .env.example as a template only

# ============================================
# Admin & God Codes (Required for owner-only dashboard)
# ============================================
# Set to your email and phone number
OWNER_EMAIL=anselm.perkins@gmail.com
OWNER_PHONE=+64224553315

# Twilio (Required for god code SMS verification)
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================
# hCaptcha (Required for build form bot protection)
# ============================================
# Get from: https://www.hcaptcha.com/
# HCAPTCHA_SITE_KEY=your-site-key
# HCAPTCHA_SECRET=your-secret-key

# ============================================
# Vanta Compliance (Optional — for SOC2/ISO audit exports)
# ============================================
# Get from: https://app.vanta.com/settings/integrations
# VANTA_WORKSPACE_ID=your-vanta-workspace-id
# VANTA_API_TOKEN=vanta_sk_xxxxxx

# ============================================
# Email (Optional — for notifications via Resend)
# ============================================
# Get from: https://resend.com/
# RESEND_API_KEY=resend_sk_xxxxxx

# ============================================
# Logging (Optional — for structured log drain)
# ============================================
# Get from: https://logtail.com/ or any HTTP log drain
# LOGTAIL_SOURCE_TOKEN=your-logtail-source-token
