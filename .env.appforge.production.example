# AppForge production environment variables — do not commit real secret values.
# The canonical production runtime is Fly.io; Vercel may host a separate frontend later.

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_APP_URL=https://YOUR_APPFORGE_DOMAIN
COOKIE_SECRET=

# Stripe account may contain multiple independent products.
# Configure only AppForge-owned product/price IDs here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_BUILDER_PRICE_ID=
STRIPE_STUDIO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
STRIPE_CUSTOM_PRICE_ID=
STRIPE_CREDITS_50_PRICE_ID=
STRIPE_CREDITS_100_PRICE_ID=
STRIPE_CREDITS_250_PRICE_ID=

# Optional infrastructure/observability values used by enabled services
REDIS_URL=
SENTRY_DSN=
APPFORGE_METRICS_TOKEN=
