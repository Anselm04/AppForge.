{
  "name": "appforge",
  "version": "1.0.0",
  "description": "AI-powered multi-agent application builder",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "node scripts/assemble-pipeline.mjs && vite",
    "build": "node scripts/assemble-pipeline.mjs && tsc -p tsconfig.server.json && vite build && sentry-cli sourcemaps inject dist",
    "start": "node dist/server.js",
    "preview": "vite preview",
    "test": "node scripts/assemble-pipeline.mjs && vitest",
    "test:e2e": "node scripts/assemble-pipeline.mjs && vitest run src/__tests__/golden-path.e2e.spec.ts src/__tests__/customer-flow-contract.e2e.spec.ts",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "typecheck": "node scripts/assemble-pipeline.mjs && tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "validate-env": "tsx scripts/validate-env.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "sentry:release": "sentry-cli releases new",
    "sentry:sourcemaps": "sentry-cli sourcemaps upload",
    "prepare": "node scripts/assemble-pipeline.mjs && (husky || true)",
    "assemble:pipeline": "node scripts/assemble-pipeline.mjs",
    "test:offline-commercial": "node scripts/check-offline-commercial-readiness.mjs",
    "audit:launch": "node scripts/audit-launch-blockers.mjs",
    "start:build-worker": "node dist/services/build-worker-entry.js"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@composio/core": "^0.21.0",
    "@monaco-editor/react": "^4.7.0",
    "@sentry/node": "^7.100.0",
    "@sentry/profiling-node": "^7.100.0",
    "@sentry/react": "^7.100.0",
    "@stripe/stripe-js": "^10.2.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tanstack/react-query": "^5.24.1",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie": "^1.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@webcontainer/api": "^1.5.1",
    "bullmq": "^6.3.15",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.2",
    "execa": "^10.0.1",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.2",
    "express-slow-down": "^3.1.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jszip": "^3.10.1",
    "pg": "^8.23.1",
    "postgres": "^3.4.0",
    "posthog-js": "^1.444.0",
    "rate-limit-redis": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^18.2.0",
    "react-router-dom": "7.18.3",
    "redis": "^5.0.0",
    "signal-exit": "^4.1.0",
    "stripe": "^14.0.0",
    "superjson": "^2.2.0",
    "typescript": "5.9.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "overrides": {
    "minimatch": "11.0.1",
    "qs": "6.16.1",
    "dompurify": "3.4.17",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "source-map-js": "1.2.2",
    "postcss-selector-parser": "7.1.6"
  },
  "devDependencies": {
    "@eslint/js": "8.57.1",
    "@sentry/cli": "3.8.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^14.2.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.2.19",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "husky": "^9.0.0",
    "jsdom": "^24.0.0",
    "lint-staged": "17.6.0",
    "postcss": "^8.4.49",
    "prettier": "^3.2.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.7.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
